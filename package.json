{
  "name": "mrz-studio-local",
  "private": true,
  "version": "7.1.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/mrz.cjs start",
    "stop": "node scripts/mrz.cjs stop",
    "restart": "node scripts/mrz.cjs restart",
    "status": "node scripts/mrz.cjs status",
    "doctor": "node scripts/mrz.cjs doctor",
    "update": "node scripts/mrz.cjs update",
    "build": "node scripts/mrz.cjs build",
    "test": "node --test --test-concurrency=1 scripts/tests/*.test.cjs",
    "package:release": "node scripts/build-release.cjs",
    "verify:release": "node scripts/verify-release.cjs"
  }
}
